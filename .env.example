# Cernity Vantage — example configuration.
# Copy to `.env` and fill in your own values:  cp .env.example .env
# `.env` is gitignored — never commit real hosts/tokens. All values are read from the
# environment (server-side only); the browser never receives URLs, hosts, or secrets.

# ── SIEM (Elasticsearch/OpenSearch) — findings source ────────────────────────
ES_URL=https://elasticsearch:9200
ES_INDEX=ndr-findings-*
ES_USER=elastic
ES_PASS=change-me                 # or leave blank + use a token-fronted proxy
# ES_CA=/certs/ca.crt             # optional: CA bundle for TLS verification

# ── Redpanda / Kafka bus (consumer-lag + throughput metrics) ─────────────────
REDPANDA_BOOTSTRAP=redpanda:9092

# ── Native metrics/health dashboard (Overview) ───────────────────────────────
# Backend: "prometheus" (default) or "influx". See docs/metrics-setup.md.
METRICS_BACKEND=prometheus
METRICS_URL=http://prometheus:9090
METRICS_TIMEOUT=5
# METRICS_TOKEN=Token <token>     # optional Authorization header (server-side only)
# METRICS_CA=/certs/metrics-ca.crt
METRICS_DB=cernity                # InfluxDB bucket/db name when METRICS_BACKEND=influx
# INFLUX_TOKEN=<token>            # required only when METRICS_BACKEND=influx
METRICS_CAPABILITIES=metrics-capabilities.json
NDR_METRICS_PORT=9108             # port Vantage exposes its own Prometheus metrics on

# ── Cernity control-plane read APIs (all server-side; tokens never reach the UI) ─
FLEET_API_URL=http://fleet-api:8000
FLEET_API_TOKEN=
FLEET_SKEW_WARN_MS=100
EVIDENCE_API_URL=http://evidence-service:8000
EVIDENCE_API_TOKEN=
COVERAGE_API_URL=http://coverage-service:8000
COVERAGE_API_TOKEN=
QUALITY_API_URL=http://coverage-service:8000
QUALITY_API_TOKEN=
CASE_API_URL=http://finding-service:8000
CASE_API_TOKEN=

# ── Local state ──────────────────────────────────────────────────────────────
SOC_DB=/data/soc.db               # triage/allowlist SQLite; mount /data as a volume
OVERVIEW_SNAPSHOT_TTL=10
